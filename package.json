{
  "name": "shop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply shop-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply shop-db --remote",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/node/server.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "hono": "^4.6.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
